# SUPABASE_URL: Your Supabase project URL (e.g., https://your-project-ref.supabase.co).
# Configure this in the Secrets panel in AI Studio (or Vercel/Render Environment Variables) to enable live multi-user sync.
SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_URL=YOUR_SUPABASE_URL

# SUPABASE_ANON_KEY: Your Supabase project anon public API key.
# Configure this in the Secrets panel in AI Studio (or Vercel/Render Environment Variables) to enable live multi-user sync.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
